MYSQL_USER=bongerd
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_DATABASE=bongerd
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# local npm (with docker-compose.dev.yml publishing mysql):
DATABASE_URL=mysql://bongerd:replace-with-a-strong-database-password@127.0.0.1:3306/bongerd
# docker compose web service ignores this and uses mysql://…@db:3306/…

SESSION_SECRET=replace-with-at-least-32-random-characters
# true behind https in production; false for plain http / local docker
COOKIE_SECURE=false
# optional: force HSTS even if COOKIE_SECURE is false (usually leave unset)
# ENABLE_HSTS=true
# true only when a trusted reverse proxy sets X-Forwarded-For
TRUST_PROXY=false

ADMIN_EMAIL=beheer@apotheekdebongerd.nl
# required on first boot (no admin yet) or when RESET_ADMIN_PASSWORD=true; omit afterwards
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# never leave true in production; rotate password after using
RESET_ADMIN_PASSWORD=false

SITE_URL=http://localhost:3000
UPLOAD_DIR=./data/uploads
